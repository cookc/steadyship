---
import Mark from './Mark.astro';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/why', label: 'Why Steadyship' },
  { href: '/get-started', label: 'Get started' },
];
---
<header class="border-b border-[var(--line)]">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-4 py-4 sm:px-6">
    <a href="/" class="flex items-center gap-3" aria-label="Steadyship home">
      <Mark size={36} />
      <span class="hidden font-display text-xl font-bold tracking-tight sm:inline">Steadyship</span>
    </a>
    <nav class="flex items-center gap-0.5 text-sm font-semibold sm:gap-2">
      {links.map((l) => (
        <a href={l.href} class:list={['whitespace-nowrap rounded-full px-2 py-2 hover:bg-[var(--surface)] sm:px-3', path === l.href && 'bg-[var(--surface)]']}>{l.label}</a>
      ))}
      <a href="https://github.com/cookc/steadyship" class="hidden rounded-full px-3 py-2 hover:bg-[var(--surface)] sm:inline-flex" rel="noopener">GitHub</a>
    </nav>
  </div>
</header>
