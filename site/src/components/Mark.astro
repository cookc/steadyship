---
// The Horizon mark, inline so it scales and needs no request.
interface Props { size?: number; class?: string; variant?: 'colour' | 'colour-dark' | 'line' }
const { size = 40, class: cls = '', variant = 'colour' } = Astro.props;
const sky = variant === 'colour-dark' ? '#FFFFFF' : '#11314F';
const mast = variant === 'colour-dark' ? '#11314F' : '#FFFFFF';
---
{variant === 'line' ? (
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 96 96" width={size} height={size} class={cls} role="img" aria-label="Steadyship" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="48" cy="48" r="43"/>
    <path d="M10 48 H86"/>
    <path d="M30 48 L36 62 Q48 68 60 62 L66 48"/>
    <path d="M48 48 V28"/>
  </svg>
) : (
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 96 96" width={size} height={size} class={cls} role="img" aria-label="Steadyship">
    <circle cx="48" cy="48" r="46" fill={sky}/>
    <path d="M2 48 A46 46 0 0 0 94 48 Z" fill="#1C7C8C"/>
    <circle cx="68" cy="30" r="5" fill="#F4B942"/>
    <path d="M30 48 L36 62 Q48 68 60 62 L66 48 Z" fill="#FFFFFF"/>
    <g fill="none" stroke-width="5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M10 48 H86" stroke="#FFFFFF"/>
      <path d="M48 48 V28" stroke={mast}/>
    </g>
  </svg>
)}
