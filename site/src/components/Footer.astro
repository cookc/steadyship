---
import Mark from './Mark.astro';
const year = new Date().getFullYear();
---
<footer class="mt-24 bg-navy text-white">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <div class="flex items-center gap-3">
        <Mark size={32} variant="colour-dark" />
        <span class="font-display text-lg font-bold">Steadyship</span>
      </div>
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-[#C6D3DE]">
        An engineer in the conversation for people building business software with Claude.
        Open source under the Apache 2.0 licence. Made in New Zealand.
      </p>
    </div>
    <div class="text-sm">
      <h3 class="font-display text-sm font-semibold uppercase tracking-wider text-[#C6D3DE]">Product</h3>
      <ul class="mt-4 space-y-2">
        <li><a class="hover:underline" href="/why">Why Steadyship</a></li>
        <li><a class="hover:underline" href="/features">Features</a></li>
        <li><a class="hover:underline" href="/get-started">Get started</a></li>
        <li><a class="hover:underline" href="https://github.com/cookc/steadyship/releases/latest">Latest release</a></li>
      </ul>
    </div>
    <div class="text-sm">
      <h3 class="font-display text-sm font-semibold uppercase tracking-wider text-[#C6D3DE]">Project</h3>
      <ul class="mt-4 space-y-2">
        <li><a class="hover:underline" href="https://github.com/cookc/steadyship">Source on GitHub</a></li>
        <li><a class="hover:underline" href="https://github.com/cookc/steadyship/issues">Report a problem</a></li>
        <li><a class="hover:underline" href="https://github.com/cookc/steadyship/blob/main/LICENSE">Licence</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <p class="mx-auto max-w-6xl px-4 py-5 text-xs text-[#C6D3DE] sm:px-6">© {year} Steadyship. Claude is a product of Anthropic; Steadyship is an independent plugin for it.</p>
  </div>
</footer>
